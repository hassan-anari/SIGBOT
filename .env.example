DATABASE_URL=sqlite+aiosqlite:///./data/chainura.db
MAIN_ADMIN_TELEGRAM_ID=123456789
TELEGRAM_BOT_TOKEN=123456789:replace_me
REDIS_URL=redis://localhost:6379/0
RENDER_TEMPLATE_ASSET_ROOT=./var/rendering/templates
RENDER_OUTPUT_ROOT=./var/rendering/output
TOOBIT_COIN_LOGO_ROOT=./var/coin_logos
RENDER_FONT_REGULAR_PATH=./var/fonts/SF-Pro-Display-Regular.otf
RENDER_FONT_MEDIUM_PATH=./var/fonts/SF-Pro-Display-Medium.otf
RENDER_FONT_SEMIBOLD_PATH=./var/fonts/SF-Pro-Display-Semibold.otf
RENDER_FONT_BOLD_PATH=./var/fonts/SF-Pro-Display-Bold.otf
RENDER_CONCURRENCY=4

# Phase 5C durable initial publication
TELEGRAM_PUBLICATION_CONCURRENCY=3
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_SEND_RETRY_BASE_SECONDS=0.5
PUBLICATION_SWEEP_SECONDS=5
# Phase 6A durable monitoring and direct Signalist notification
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=5
MONITORING_CONCURRENCY=8
MONITORING_BATCH_SIZE=100
BREAKEVEN_MIN_OPEN_SECONDS=300
BREAKEVEN_FAVORABLE_MOVE_PERCENT=1.00
BREAKEVEN_EXECUTION_TOLERANCE_PERCENT=0.10
BREAKEVEN_REARM_DISTANCE_PERCENT=0.20
BREAKEVEN_PROMPT_COOLDOWN_SECONDS=900
SIGNALIST_NOTIFICATION_CONCURRENCY=3
SIGNALIST_NOTIFICATION_MAX_ATTEMPTS=3
SIGNALIST_NOTIFICATION_RETRY_BASE_SECONDS=0.5
SIGNALIST_NOTIFICATION_SWEEP_SECONDS=5
